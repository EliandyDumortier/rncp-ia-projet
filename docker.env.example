# Copy this file to docker.env, then replace every required placeholder.
# docker.env is ignored by Git and must never be committed.

DB_PASSWORD=
JWT_SECRET=
USER_PASSWORD=
ADMIN_PASSWORD=

# Public URLs embedded in the browser bundle during the Docker build.
VITE_API_DATA_URL=http://localhost:8000
VITE_API_IA_URL=http://localhost:8001

# Optional browser fallback. Prefer Supabase's sb_publishable_ key format.
# Leave both empty to use only the data API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
