# ============================================================
# Dockerfile — Image Docker pour l'API REST de données (etape1)
# Fichier : docker/Dockerfile.api
#
# Build : docker build -t kdrama-data-api -f docker/Dockerfile.api .
# Run   : docker run -p 8000:8000 kdrama-data-api
#
# Auteur : Équipe Data
# Étape 1 — RNCP AI Project
# ============================================================

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt

# --- Stage 2 : Runtime ---
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    API_HOST=0.0.0.0 \
    API_PORT=8000

RUN groupadd -r kdrama && \
    useradd -r -g kdrama -d /app -s /sbin/nologin -c "K-Drama API User" kdrama

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
COPY --chown=kdrama:kdrama src/ /app/src/
COPY --chown=kdrama:kdrama requirements.txt /app/requirements.txt

USER kdrama

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000"]
