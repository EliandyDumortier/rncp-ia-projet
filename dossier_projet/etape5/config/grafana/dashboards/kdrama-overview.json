      "fieldConfig": {"defaults": {"min": 0, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 13},
      "id": 6,
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum(rate(kdrama_api_requests_total[5m])) by (endpoint)", "legendFormat": "{{endpoint}}", "refId": "A"}],
      "title": "Débit de l'API modèle",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Ratio erreurs/requêtes sur cinq minutes. Seuil critique : 5 %.",
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.02}, {"color": "red", "value": 0.05}]}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 13},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "sum(rate(kdrama_api_errors_total[5m])) / clamp_min(sum(rate(kdrama_api_requests_total[5m])), 1)", "legendFormat": "taux d'erreur", "refId": "A"}],
      "title": "Taux d'erreur du modèle",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "PSI : stable sous 0,10, modéré jusqu'à 0,25, critique à partir de 0,25.",
      "fieldConfig": {"defaults": {"decimals": 3, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}, {"color": "red", "value": 0.25}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 13},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "kdrama_model_prediction_drift", "legendFormat": "{{model_type}}", "refId": "A"}],
      "title": "Dérive des prédictions (PSI)",
      "type": "timeseries"
    }
