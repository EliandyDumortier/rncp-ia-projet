      "description": "1 indique que le point de santé répond ; 0 indique une indisponibilité réseau ou HTTP.",
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "mappings": [{"options": {"0": {"text": "INDISPONIBLE"}, "1": {"text": "JOIGNABLE"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "kdrama_service_up", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "Joignabilité des services",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "État fonctionnel déclaré par chaque service, y compris la base et le modèle.",
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "mappings": [{"options": {"0": {"text": "DÉGRADÉ"}, "1": {"text": "SAIN"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "kdrama_service_healthy", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "Santé fonctionnelle",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Nombre d'alertes actuellement actives, regroupées par gravité.",
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 2}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
      "id": 3,
