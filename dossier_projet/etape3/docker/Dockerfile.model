# ============================================================
# Dockerfile — Image Docker pour l'API du modèle de recommandation
# Fichier : docker/Dockerfile.model
#
# Image multi-stage pour optimiser la taille :
#   Stage 1 (builder) : installation des dépendances
#   Stage 2 (runtime) : image finale légère
#
# Build : docker build -t kdrama-recommender-api -f docker/Dockerfile.model .
# Run   : docker run -p 8001:8001 kdrama-recommender-api
#
# Auteur : Équipe MLOps
# Étape 3 — RNCP AI Project
# ============================================================

# --- Stage 1 : Builder ---
FROM python:3.11-slim AS builder

# Métadonnées de build
ARG BUILD_DATE
ARG GIT_COMMIT
ARG VERSION=1.0.0

LABEL maintainer="Équipe MLOps <mlops@kdrama-recommender.io>"
LABEL org.opencontainers.image.title="K-Drama Recommender API"
LABEL org.opencontainers.image.description="API REST exposant un modèle de recommandation hybride de K-Dramas"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
LABEL org.opencontainers.image.source="https://github.com/rncp-ai/kdrama-recommender"
LABEL org.opencontainers.image.licenses="MIT"

# Variables d'environnement pour Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Répertoire de travail
WORKDIR /app

# Installation des dépendances système de build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copie du fichier de requirements
COPY requirements.txt .

# Installation des dépendances Python dans un virtualenv dédié
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ============================================================
# --- Stage 2 : Runtime ---
# ============================================================
FROM python:3.11-slim AS runtime

# Variables d'environnement
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    API_HOST=0.0.0.0 \
    API_PORT=8001 \
    LOG_LEVEL=info

# Création d'un utilisateur non-root (sécurité OWASP)
RUN groupadd -r kdrama && \
    useradd -r -g kdrama -d /app -s /sbin/nologin -c "K-Drama API User" kdrama

# Répertoire de travail
WORKDIR /app

# Installation des dépendances système runtime (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copie du virtualenv depuis le builder
COPY --from=builder /opt/venv /opt/venv

# Copie du code source
COPY --chown=kdrama:kdrama src/ /app/src/
COPY --chown=kdrama:kdrama requirements.txt /app/requirements.txt

# Sécurise les permissions de l'application
RUN chown -R kdrama:kdrama /app

# Bascule vers l'utilisateur non-root
USER kdrama

# Healthcheck : vérifie l'endpoint /health toutes les 30 secondes
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Exposition du port
EXPOSE 8001

# Un seul worker charge le modèle en mémoire. Plusieurs workers dupliqueraient
# l'entraînement et la RAM (particulièrement coûteux sur Render).
CMD ["gunicorn", "model_api:app", \
     "--bind", "0.0.0.0:8001", \
     "--workers", "1", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--timeout", "120", \
     "--keep-alive", "5", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--log-level", "info"]
